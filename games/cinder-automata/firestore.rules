rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Crystalbound Saga: one save document per signed-in player. Nobody else can read or write it.
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Cinder Automata: one document per signed-in player holding their run and progress.
    // Only the owner can touch it, only once their email address is confirmed, only with the fields the game writes, and not larger than about 1 MB.
    match /cinderSaves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
      allow create, update: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly(['v', 'run', 'runSavedAt', 'level', 'profile', 'savedAt', 'summary'])
        && request.resource.data.v == 1
        && (request.resource.data.run == null || (request.resource.data.run is string && request.resource.data.run.size() < 900000));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
