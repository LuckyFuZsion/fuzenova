# Sign-in emails (verification + password reset), sent from our own domain instead of Firebase's.
# Set these in Vercel (Production and Preview) and in .env.local for local testing. Never commit real values.

# Resend API key with "sending access" for the verified sending domain.
RESEND_API_KEY=
# Sender shown to players, e.g.  FuzeNova Games <noreply@send.fuzenova.dev>
MAIL_FROM=
# Full JSON of the limited "fuzenova-mailer" service account (role: Firebase Authentication Admin), or its base64.
FIREBASE_SERVICE_ACCOUNT=
# The public address of this site, used to build the links in the emails.
NEXT_PUBLIC_SITE_URL=https://www.fuzenova.dev

# Where contact-form messages are delivered (optional; defaults to fuzenova@webfuzsion.co.uk).
CONTACT_TO=
